<script goose>
// Nested {#for} and {#if}, {#let}, bind:value and bind:checked, and
// on: arguments of each kind.
struct Cell { v: i64, mark: bool }
struct State { title: u8[..32], show: bool, size: i64, cells: Cell[>..<] }

fn tap(s: State&, i: i64, on: bool, label: const u8[:]) {
    s.size = i;
    s.show = on;
    s.title.clear();
    s.title.append(label);
}

fn test_grid(s: State&) {
    s.title.append("grid <1> & \"2\"");
    s.show = true;
    s.size = 3;
    for i in 7 { s.cells.push(Cell { v: i * i, mark: i % 2 == 0 }); }
}

fn test_hidden(s: State&) {
    test_grid(s);
    tap(s, 2, false, "off");
}
</script>
<h3 title="{s.title}">{s.title}</h3>
<input bind:value="title"> <input type="checkbox" bind:checked="show"> <input type="number" bind:value="size">
{#if s.show}
<table>
{#for r in s.size}
<tr>{#for c in s.size}{#let k = r * s.size + c}{#if k < s.cells.len}{#let cell = s.cells[k]}<td class="{#if cell.mark}m{#else if cell.v > 10}big{#else}n{/if}" on:click="tap(k, cell.mark, s.title)">{cell.v}</td>{#else}<td></td>{/if}{/for}</tr>
{/for}
</table>
{#else}
<p>hidden</p>
{/if}
<p>{#for c, i in s.cells}{#if i > 0}, {/if}{i}={c.v}{#if c.mark}*{/if}{/for}</p>
