<script goose>
// Goose's / truncates and its % is Euclidean; both must hold in the client.
struct State { log: u8[..600], q: i64, r: i64 }

fn both(s: State&, a: i64, b: i64) {
    s.log.append(str(a, "/", b, "=", a / b, " ", a, "%", b, "=", a % b, "; "));
}

fn test_signs(s: State&) {
    both(s, 7, 3);
    both(s, -7, 3);
    both(s, 7, -3);
    both(s, -7, -3);
    both(s, 6, 3);
    both(s, -6, 3);
    both(s, 6, -3);
    both(s, 0, 5);
    both(s, 0, -5);
    both(s, 1, 2);
    both(s, -1, 2);
    both(s, 1000000000000007, 7);
    both(s, -1000000000000007, 10);
    s.q = 17;
    s.q /= -4;
    s.r = -17;
    s.r %= 4;
}
</script>
<p>{s.log}</p>
<p>{s.q} {s.r}</p>
<p>{#for i in 9}{(i - 4) / 3},{(i - 4) % 3},{(i - 4) % -3} {/for}</p>
