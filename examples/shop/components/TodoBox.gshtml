<script goose>
struct Item { id: i64, title: u8[..200], done: bool }
struct State { draft: u8[..200], next_id: i64, items: Item[>..<] }

fn add(s: State&) {
    if s.draft.len == 0 { return; }
    s.items.push(Item { id: s.next_id, title: s.draft, done: false });
    s.next_id += 1;
    s.draft.clear();
}
fn toggle(s: State&, id: i64) {
    for i in s.items.len { if s.items[i].id == id { s.items[i].done = !s.items[i].done; } }
}
fn remove(s: State&, id: i64) {
    for i in s.items.len { if s.items[i].id == id { s.items.remove_at(i); return; } }
}
fn left(s: const State&) -> i64 {
    var n = 0;
    for t in s.items { if !t.done { n += 1; } }
    return n;
}

fn test_basic(s: State&) {
    s.draft.append("milk & <eggs>");
    add(s);
    s.draft.append("write \"gshtml\" ✓");
    add(s);
    s.draft.append("ship it");
    add(s);
    toggle(s, 1);
    remove(s, 0);
    add(s);
}
</script>
<form on:submit="add">
<input name="draft" bind:value="draft" maxlength="200" placeholder="What needs doing?">
<button>Add</button>
</form>
<ul>
{{#for t in s.items}}
<li class="{{#if t.done}}done{{/if}}"><input type="checkbox" {{#if t.done}}checked{{/if}} on:change="toggle(t.id)"> {{ t.title }} <button on:click="remove(t.id)">x</button></li>
{{/for}}
</ul>
<p>{{ left(s) }} of {{ s.items.len }} left</p>
